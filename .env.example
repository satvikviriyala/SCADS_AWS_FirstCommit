# SCADS environment configuration — copy to .env and fill in.
# NEVER commit a real .env. No AWS access keys belong in this file for deployed
# code: deployed Lambdas use IAM execution roles.

# ---------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------
SCADS_ENV=dev
AWS_REGION=ap-south-1
SCADS_STACK_NAME=scads-dev

# ---------------------------------------------------------------------------
# Storage / persistence backends
#   STORE_BACKEND: s3 | local     (object storage for scans + references)
#   REPO_BACKEND:  dynamodb | local (registry, scan events, reference profiles)
# "local" is for offline development and unit tests ONLY. The deployed smoke
# test asserts the deployed API reports the aws backends.
# ---------------------------------------------------------------------------
STORE_BACKEND=s3
REPO_BACKEND=dynamodb

SCAN_BUCKET=
REFERENCE_BUCKET=
REGISTRY_TABLE=
SCAN_EVENTS_TABLE=
REFERENCE_TABLE=

# Local backend root (used only when *_BACKEND=local)
SCADS_LOCAL_ROOT=.scads-local

# ---------------------------------------------------------------------------
# OCR
#   OCR_PROVIDER: textract | fixture | none
# "fixture" reads sidecar JSON next to a local fixture image and is for tests
# only. It is reported verbatim in the scan evidence so a fixture-backed run can
# never be mistaken for a Textract-backed one.
# ---------------------------------------------------------------------------
OCR_PROVIDER=textract
TEXTRACT_MAX_BYTES=5242880

# ---------------------------------------------------------------------------
# Optional Bedrock explanation (never authoritative for the decision)
# ---------------------------------------------------------------------------
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_REGION=
BEDROCK_TIMEOUT_SECONDS=4

# ---------------------------------------------------------------------------
# Upload constraints
# ---------------------------------------------------------------------------
UPLOAD_MAX_BYTES=8388608
UPLOAD_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Admin plane (demo reset). Leave empty to disable the endpoint entirely.
# Set via SSM/Secrets Manager in real deployments, not in this file.
# ---------------------------------------------------------------------------
ADMIN_API_TOKEN=

# ---------------------------------------------------------------------------
# CORS: comma-separated allowed origins for the browser client.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8000

# ---------------------------------------------------------------------------
# Local dev server
# ---------------------------------------------------------------------------
SCADS_DEV_PORT=8000
